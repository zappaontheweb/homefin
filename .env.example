# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables (the KV_* ones are added automatically
# when you connect a KV / Upstash Redis store to the project).

# Required. Secret "setup token" asked once by the first-run wizard to create the
# workspace, and used for emergency password resets (see README → Troubleshooting).
# Use a long random value, e.g. `openssl rand -base64 24`.
APP_PASSWORD=

# Required in production: REST credentials of your KV (Upstash Redis) store.
# Leave empty locally to use the in-memory store that `npm run dev` provides.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional. KV key the whole workspace is stored under (default: homefin:data).
# HOMEFIN_KV_KEY=homefin:data

# Optional. Comma-separated origins allowed to call /api/data cross-origin.
# Leave empty: the bundled frontend is same-origin and needs no CORS.
# ALLOWED_ORIGINS=https://example.com
